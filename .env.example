SECRET_KEY=change-me
LOG_LEVEL=INFO
GEMINI_API_KEY=
# Comma-separated e-mails that may use the AI assistant without a payment (not file analysis).
AI_TEMPORARY_ACCESS_EMAILS=
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
ALLOWED_HOSTS=localhost
CSRF_TRUSTED_ORIGINS=
USE_HTTPS=True
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
FIELD_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Readable path INSIDE the backend runtime to the Firebase service-account JSON.
# Empty disables FCM. Use the same project as the frontend Firebase/VAPID config.
# Production Compose overrides this with /run/secrets/firebase_admin.
# Setup, frontend contract and event matrix: docs/PUSH_NOTIFICATIONS.md
FIREBASE_CREDENTIALS=
MP_ACCESS_TOKEN=
# Browser app origin (not /api/v1); HTTPS is required for FCM notification click links.
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379/0
# GitHub App (login + repository integration). Setup and minimal permissions: docs/GITHUB.md
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM on one line with literal \n between lines, or the real multi-line value in the secret store
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Defaults to $FRONTEND_URL/integrations/github/callback
GITHUB_OAUTH_REDIRECT_URI=

# Reuniões (LiveKit) - ver docs/REUNIOES.md
# local: livekit-server em ws://127.0.0.1:7880; produção: wss://<projeto>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# bucket das gravações (S3, R2 ou MinIO). ENDPOINT vazio = AWS S3
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_REGION=
RECORDINGS_S3_ENDPOINT=
RECORDINGS_S3_ACCESS_KEY=
RECORDINGS_S3_SECRET_KEY=
MEETING_RECORDING_RETENTION_DAYS=90
