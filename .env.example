SECRET_KEY=change-me
LOG_LEVEL=INFO
GEMINI_API_KEY=
# Comma-separated e-mails that may use the AI assistant without a payment (not file analysis).
AI_TEMPORARY_ACCESS_EMAILS=
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
ALLOWED_HOSTS=localhost
CSRF_TRUSTED_ORIGINS=
USE_HTTPS=True
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
FIELD_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Readable path INSIDE the backend runtime to the Firebase service-account JSON.
# Empty disables FCM. Use the same project as the frontend Firebase/VAPID config.
# Production Compose overrides this with /run/secrets/firebase_admin.
# Setup, frontend contract and event matrix: docs/PUSH_NOTIFICATIONS.md
FIREBASE_CREDENTIALS=
MP_ACCESS_TOKEN=
# Browser app origin (not /api/v1); HTTPS is required for FCM notification click links.
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379/0
# GitHub App (login + repository integration). Setup and minimal permissions: docs/GITHUB.md
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM on one line with literal \n between lines, or the real multi-line value in the secret store
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Defaults to $FRONTEND_URL/integrations/github/callback
GITHUB_OAUTH_REDIRECT_URI=

# Meetings (LiveKit) - see docs/REUNIOES.md
# local: livekit-server at ws://127.0.0.1:7880; production: wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# recordings bucket (S3, R2 or MinIO). Empty ENDPOINT = AWS S3
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_REGION=
RECORDINGS_S3_ENDPOINT=
RECORDINGS_S3_ACCESS_KEY=
RECORDINGS_S3_SECRET_KEY=
MEETING_RECORDING_RETENTION_DAYS=90

# Meeting transcription and summary, all on our own server - see docs/IA-REUNIOES.md
# true turns the pipeline on in the Celery worker (needs ffmpeg and Ollama)
MEETING_AI_ENABLED=false
# faster-whisper: tiny, base, small, medium, large-v3-turbo...; downloaded on first use
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=
MEETING_AI_LANGUAGE=pt
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_CONTEXT_TOKENS=32768
# per-recording limits (90 min and 2 GB)
MEETING_AI_MAX_SECONDS=5400
MEETING_AI_MAX_BYTES=2147483648
